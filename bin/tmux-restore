#!/usr/bin/env bash
# Safe wrapper around tmux-resurrect's restore.sh.
#
# Why this exists: restore.sh derives the target socket from $TMUX via
#   tmux_socket() { echo $TMUX | cut -d',' -f1; }
# and then runs `TMUX="" tmux -S "$(tmux_socket)" new-session ...`.
# Invoked from a plain shell $TMUX is unset, so it restores into `tmux -S ''`
# -- a separate, orphaned server that `tmux ls` never shows.
#
# This wrapper pins $TMUX to a real server so sessions land where you can see
# them. Inside tmux it is a no-op passthrough.
#
# Usage: tmux-restore [-L socket-name | -S socket-path]
set -euo pipefail

RESTORE_SCRIPT="${HOME}/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
[ -x "$RESTORE_SCRIPT" ] || { echo "tmux-restore: $RESTORE_SCRIPT not found" >&2; exit 1; }

sock_name=""
sock_path=""
while [ $# -gt 0 ]; do
	case "$1" in
		-L) sock_name="$2"; shift 2 ;;
		-S) sock_path="$2"; shift 2 ;;
		-h|--help) sed -n '2,14p' "$0"; exit 0 ;;
		*) echo "tmux-restore: unknown argument '$1'" >&2; exit 2 ;;
	esac
done

if [ -n "${TMUX:-}" ]; then
	exec "$RESTORE_SCRIPT"
fi

# Resolve the socket path the way tmux(1) does for -L: $TMUX_TMPDIR (or /tmp)
# plus a tmux-UID directory. We cannot ask tmux for it: on a server without
# sessions (the boot server started via `tmux start-server` has none until the
# restore runs) both `has-session` and `display-message` fail.
if [ -n "$sock_path" ]; then
	socket="$sock_path"
else
	socket="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/${sock_name:-default}"
fi

# `show -s` (server options) is the one query that succeeds on a live server
# even with zero sessions, and fails on a dead or absent one.
if ! tmux -S "$socket" show -s >/dev/null 2>&1; then
	echo "tmux-restore: no running tmux server on ${socket}; start one first (e.g. 'tmux new-session -d')" >&2
	exit 1
fi

TMUX="${socket},0,0" "$RESTORE_SCRIPT"
echo "tmux-restore: restored into ${socket}"
tmux -S "$socket" list-sessions
