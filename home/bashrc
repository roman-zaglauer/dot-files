# Fuzzy project jump: `j <partial-name>`
j() {
  local dir
  dir=$(find ~/projects -maxdepth 3 -type d -name ".git" 2>/dev/null \
    | sed 's|/.git||' \
    | grep -i "${1:-}" \
    | head -20 \
    | sort \
    | ([ -t 0 ] && cat || fzf 2>/dev/null || head -1))
  [ -n "$dir" ] && cd "$dir" || echo "No match for: $1"
}

