# --- Welcome message ----------------------------------------------------------
# Show once per top-level interactive shell
if [ "${SHLVL:-0}" -eq 1 ] && [ -z "${BASH_WELCOME_SHOWN:-}" ]; then
  export BASH_WELCOME_SHOWN=1
  user_name="${USER:-$(id -un 2>/dev/null)}"
  first_name="$(getent passwd "$user_name" | cut -d: -f5 | awk -F',' '{print $1}' | awk '{print $1}')"
  [ -z "${first_name}" ] && first_name="${user_name}"
  quotes_file="${XDG_CACHE_HOME:-$HOME/.cache}/bofh_quotes.txt"
  quotes_url="https://www.cs.wisc.edu/~ballard/bofh/excuses"
  printf '\nWelcome back, %s!\n' "${first_name}"
  printf '\nToday is %s the %s - %s\n' "$(date '+%A')" "$(date '+%d.%m.%Y')" "$(date '+%H:%M')"
  mkdir -p "$(dirname "$quotes_file")"
  # Refresh weekly, and only replace the cache on successful download.
  if [ ! -s "$quotes_file" ] || [ $(( $(date +%s) - $(stat -c %Y "$quotes_file" 2>/dev/null || echo 0) )) -gt 604800 ]; then
    tmp_file="${quotes_file}.$$"
    if curl -fsSL --connect-timeout 3 --max-time 8 "$quotes_url" -o "$tmp_file"; then
      mv -f "$tmp_file" "$quotes_file"
    else
      rm -f "$tmp_file"
    fi
  fi
  if [ -s "$quotes_file" ]; then
    bofh_quote="$(shuf -n 1 "$quotes_file" 2>/dev/null)"
    [ -n "$bofh_quote" ] && printf '\nBOFH Excuse: %s\n\n' "$bofh_quote"
  fi
fi

