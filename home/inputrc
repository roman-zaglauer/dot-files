# Readline configuration — shared by bash, psql, node REPL, etc.

$include /etc/inputrc

# --- 8-bit clean (needed for German umlauts and other high-bit chars) ------
set input-meta on
set output-meta on
set meta-flag on
set convert-meta off

set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set show-all-if-unmodified on
set colored-completion-prefix on
set colored-stats on
set mark-symlinked-directories on
set visible-stats on
set skip-completed-text on
set bell-style none
set editing-mode emacs

# History search with arrow keys (prefix-match)
"\e[A": history-search-backward
"\e[B": history-search-forward

# Word-wise navigation with Ctrl+Left/Right
"\e[1;5C": forward-word
"\e[1;5D": backward-word

# Optional machine-local override.
# NOTE: readline emits a warning if the file is missing, so it is intentionally
# left out here. Add `$include ~/.dotfiles/inputrc` yourself if you need it.
